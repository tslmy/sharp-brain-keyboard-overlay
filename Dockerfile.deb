# SPDX-License-Identifier: MIT
# Dockerfile.deb — cross-compiles keyoverlay for armel or armhf.
#
# Usage (via Makefile):
#   make deb          # build image + run container, outputs dist/keyoverlay_armel.deb
#
# The resulting package can be added to an apt repository and installed with:
#   apt install keyoverlay
#
# Runtime deps on target: libc6 (no X11 needed; X11 backend is opt-in at build).
ARG BUILDER_PLATFORM=linux/amd64
FROM --platform=${BUILDER_PLATFORM} debian:trixie

ENV DEBIAN_FRONTEND=noninteractive
ARG DEB_ARCH=armel

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils \
        build-essential \
        dpkg-dev \
        crossbuild-essential-${DEB_ARCH} \
        make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# Cross-compile (framebuffer backend only; no X11 on bare Debian console).
RUN set -eu; \
    case "$DEB_ARCH" in \
        armel) compiler=arm-linux-gnueabi-gcc ;; \
        armhf) compiler=arm-linux-gnueabihf-gcc ;; \
        *) echo "Unsupported architecture: $DEB_ARCH" >&2; exit 1 ;; \
    esac; \
    make clean; \
    make CC="$compiler" WITHOUT_X11=1 CFLAGS="-O2 -Wall -Wextra"

# Assemble the .deb package tree under /pkg.
ARG DEB_VERSION
RUN set -e; \
    mkdir -p /pkg/DEBIAN \
             /pkg/usr/bin \
             /pkg/lib/systemd/system \
             /pkg/etc/default; \
    install -m 0755 keyoverlay              /pkg/usr/bin/keyoverlay; \
    install -m 0644 init/keyoverlay.service /pkg/lib/systemd/system/keyoverlay.service; \
    install -m 0644 init/keyoverlay.default /pkg/etc/default/keyoverlay; \
    install -m 0644 debian/control          /pkg/DEBIAN/control; \
    install -m 0644 debian/conffiles        /pkg/DEBIAN/conffiles; \
    install -m 0755 debian/postinst         /pkg/DEBIAN/postinst; \
    sed -i "s/^Architecture:.*/Architecture: ${DEB_ARCH}/" /pkg/DEBIAN/control; \
    if [ -n "${DEB_VERSION}" ]; then \
    sed -i "s/^Version:.*/Version: ${DEB_VERSION}/" /pkg/DEBIAN/control; \
    fi

RUN dpkg-deb --build --root-owner-group /pkg /keyoverlay_${DEB_ARCH}.deb

# Default command: copy the deb to the /out mount point.
ENV DEB_ARCH=${DEB_ARCH}
CMD ["sh", "-c", "cp /keyoverlay_${DEB_ARCH}.deb /out/"]
